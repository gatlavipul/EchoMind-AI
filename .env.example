# EchoMind AI — Production Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
SQLITE_PATH=echomind.db

# Qdrant Cloud Vector Database (https://cloud.qdrant.io)
# 1. Sign up and create a cluster.
# 2. Copy the Cluster URL and API Key from the Qdrant Cloud console.
# 3. Collection dimension: 384, Distance: Cosine.
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=echomind_memories

# Lyzr Agent Studio (https://studio.lyzr.ai)
# 1. Sign up and create an Agent.
# 2. Copy the API Key and Agent ID from the Lyzr Studio settings.
LYZR_API_KEY=lyzr_api_key_here
LYZR_AGENT_ID=your_lyzr_agent_id_here
LYZR_USER_ID=echomind-user
LYZR_INFERENCE_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/

# Omi Wearable Developer Platform (https://docs.omi.me)
# 1. For REST Developer API (/v1/dev/user/conversations), use an omi_dev_... key.
# 2. For Model Context Protocol tools, use an omi_mcp_... key.
# 3. Webhook ingestion (/api/ingest/omi) and speech-to-text mic work out of the box without keys.
OMI_API_KEY=omi_dev_your_key_here
